# =============================================================================
# NETLIFY — MUST BE SECRET (tick "Secret" in Netlify UI)
# =============================================================================
# Never commit real values to Git. Copy from your local .env or Firebase JSON.
# One variable per row in Netlify — never paste the whole file into one field.
# =============================================================================

# Firebase Admin private key — pick ONE method on Netlify:

# Option A (recommended on Netlify): base64 of the full PEM file
# Generate locally:  node scripts/_gen-b64-key.mjs
# Then paste contents of scripts/_private-key-b64.txt here:
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=paste_one_long_base64_line_here

# Option B (local dev / if base64 not used): PEM with \n for newlines, in quotes
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary — never expose
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# On-demand cache revalidation — use a long random string (not 1234567890)
REVALIDATE_SECRET=use_a_long_random_string_here

# Future email (if you enable it later)
# RESEND_API_KEY=your_resend_key

# =============================================================================
# NEVER UPLOAD TO NETLIFY / NEVER COMMIT
# =============================================================================
# - Your full local .env file as one blob
# - Firebase service account JSON file (*.json from Google)
# - Any file containing FIREBASE_ADMIN_PRIVATE_KEY in plain text in the repo
# =============================================================================
